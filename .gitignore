# Only include frontend, backend, and .gitignore - exclude everything else at root
/*
!/frontend/
!/backend/
!/.gitignore

# Exclude specific folders within backend
backend/backend_deploy/
backend/database_scripts/
backend/scripts&sql/

# Exclude Excel files in backend
backend/**/*.xlsx
backend/**/*.xls

# Kiro and IDE folders
.kiro/
.vscode/
.idea/
*.swp
*.swo
*~

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Environment variables (excluded due to GitHub secret scanning)
.env
*.env
!.env.example

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Build outputs and archives
/frontend/dist/
/frontend/build/
*.zip

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Database
*.db
*.sqlite
*.sqlite3

# Temporary files
*.tmp
*.temp
