# Frontend Environment Variables Template
# Copy this file to .env.local for development or .env.production for production builds

# API Configuration
VITE_API_BASE=http://localhost:5000

# Company Configuration
VITE_COMPANY_CODE=your_company_code
VITE_COMPANY_NAME=Your Company Name
VITE_COMPANY_LOGO=https://www.yourcompany.com/logo.png

# Notes:
# - VITE_COMPANY_CODE: Used in API headers (X-Company-Code) to identify tenant
# - VITE_COMPANY_NAME: Displayed in browser title, header, sidebar
# - VITE_COMPANY_LOGO: URL to company logo image (displayed in header and sidebar)
# - All VITE_ prefixed variables are exposed to the client-side code
